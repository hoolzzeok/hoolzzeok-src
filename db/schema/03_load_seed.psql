\set ON_ERROR_STOP on
\copy data_sources (id,title,publisher,url,as_of,confidence,refresh_cycle,note) FROM 'seed/data_sources.csv' WITH (FORMAT csv, HEADER true)
\copy provinces (code,name_en,lodging_region) FROM 'seed/provinces.csv' WITH (FORMAT csv, HEADER true)
\copy places (id,name_ko,name_en,province,lat,lon,tier,kind,island,price_level,half_price_pilot,source_id) FROM 'seed/places.csv' WITH (FORMAT csv, HEADER true)
\copy place_profiles (place_id,desc_ko,desc_en,note_ko,note_en,festival_ko,festival_en,source_id) FROM 'seed/place_profiles.csv' WITH (FORMAT csv, HEADER true)
\copy place_spots (place_id,seq,name_ko,name_en,is_night_view,lat,lon,tour_api_id) FROM 'seed/place_spots.csv' WITH (FORMAT csv, HEADER true)
\copy place_foods (place_id,seq,name_ko,name_en) FROM 'seed/place_foods.csv' WITH (FORMAT csv, HEADER true)
\copy events (id,place_id,kind,name_ko,name_en,start_date,end_date,detail_ko,detail_en,source_id) FROM 'seed/events.csv' WITH (FORMAT csv, HEADER true)
\copy agent_picks (id,audience,place_id,until,tag,text_ko,text_en,text_ja,text_zh) FROM 'seed/agent_picks.csv' WITH (FORMAT csv, HEADER true)
\copy season_products (id,name_ko,name_en,source_id) FROM 'seed/season_products.csv' WITH (FORMAT csv, HEADER true)
\copy season_months (product_id,month) FROM 'seed/season_months.csv' WITH (FORMAT csv, HEADER true)
\copy season_places (product_id,place_id) FROM 'seed/season_places.csv' WITH (FORMAT csv, HEADER true)
\copy activities (id,place_id,kind,type_ko,type_en,name_ko,price_text,duration_text,note,source_url,source_as_of,rep_price) FROM 'seed/activities.csv' WITH (FORMAT csv, HEADER true)
\copy contests (id,place_id,province,hub_place_id,nationwide,end_date,name_ko,name_en,type_ko,type_en,prize_ko,prize_en,who_ko,who_en,url) FROM 'seed/contests.csv' WITH (FORMAT csv, HEADER true)
\copy souvenirs (place_id,name_ko,name_en,price,basis,source_url) FROM 'seed/souvenirs.csv' WITH (FORMAT csv, HEADER true)
\copy official_malls (scope,scope_key,name,description,url,source_id) FROM 'seed/official_malls.csv' WITH (FORMAT csv, HEADER true)
\copy lodging_rates (lodging_type,region,month,adr_krw,data_year,source_id) FROM 'seed/lodging_rates.csv' WITH (FORMAT csv, HEADER true)
\copy dorm_bed_rates (region_key,price,source_id) FROM 'seed/dorm_bed_rates.csv' WITH (FORMAT csv, HEADER true)
\copy food_prices (province,item,price,source_id) FROM 'seed/food_prices.csv' WITH (FORMAT csv, HEADER true)
\copy meal_baskets (style,item,qty,source_id) FROM 'seed/meal_baskets.csv' WITH (FORMAT csv, HEADER true)
\copy city_bus_fares (province,fare,source_id) FROM 'seed/city_bus_fares.csv' WITH (FORMAT csv, HEADER true)
\copy taxi_fares (province,base_fare,base_km,meters_per_100won,source_id) FROM 'seed/taxi_fares.csv' WITH (FORMAT csv, HEADER true)
\copy flight_fares (from_place,to_place,fare,basis,source_id) FROM 'seed/flight_fares.csv' WITH (FORMAT csv, HEADER true)
\copy ferry_fares (island_group,port_place_id,fare,source_id) FROM 'seed/ferry_fares.csv' WITH (FORMAT csv, HEADER true)
\copy cost_params (key,value,unit,note,source_id) FROM 'seed/cost_params.csv' WITH (FORMAT csv, HEADER true)
\copy fx_rates (rate_date,currency,krw_per_unit,source) FROM 'seed/fx_rates.csv' WITH (FORMAT csv, HEADER true)
\copy goodprice_eateries (id,place_id,name,category,subcategory,address,district,neighborhood,road,min_meal_price,price_band,is_full_meal,has_grill,source_id) FROM 'seed/goodprice_eateries.csv' WITH (FORMAT csv, HEADER true)
\copy goodprice_menus (eatery_id,seq,menu,price,is_meal) FROM 'seed/goodprice_menus.csv' WITH (FORMAT csv, HEADER true)
\copy goodprice_stays (id,place_id,name,min_night_price,address,district,neighborhood,road,source_id) FROM 'seed/goodprice_stays.csv' WITH (FORMAT csv, HEADER true)
\copy goodprice_stay_rates (stay_id,seq,item,price) FROM 'seed/goodprice_stay_rates.csv' WITH (FORMAT csv, HEADER true)
\copy checklist_items (key,audience,name,reason,partner,affiliate_url) FROM 'seed/checklist_items.csv' WITH (FORMAT csv, HEADER true)
